FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy entire src package (api + config + data + monitoring + logging_config)
COPY src/ ./src/
COPY models/ ./models/

# Ensure monitoring directory exists for SQLite prediction log
RUN mkdir -p monitoring

EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
